# Copy to .env on the server (never commit .env) and fill in the values.

# ─── Site ────────────────────────────────────────────────────
# Your domain, without https:// (the DNS "A" record must point to the server).
DOMAINE=[À COMPLÉTER : votre-domaine.be]
# Receives alerts (failed paid report, refund that needs a manual action) and quote requests.
ADMIN_EMAIL=[À COMPLÉTER : vous@votre-domaine.be]

# ─── E-mails (Brevo, SMTP) ───────────────────────────────────
# Without SMTP_HOST, e-mails are only written to files in the data volume (data/mails): nothing is sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=[À COMPLÉTER : identifiant SMTP Brevo]
SMTP_PASS=[À COMPLÉTER : clé SMTP Brevo]
# The domain must be authenticated in Brevo (SPF + DKIM), or e-mails will land in spam.
MAIL_FROM=Vérificateur d'accessibilité <rapport@[À COMPLÉTER : votre-domaine.be]>

# ─── Paid report (Stripe) ────────────────────────────────────
# Test mode first (sk_test_…), then live keys (sk_live_…) once everything works.
# Without STRIPE_SECRET_KEY, the paid offer is simply hidden.
STRIPE_SECRET_KEY=[À COMPLÉTER : sk_test_…]
# Created with the webhook endpoint https://DOMAINE/api/stripe/webhook (see DEPLOIEMENT.md).
STRIPE_WEBHOOK_SECRET=[À COMPLÉTER : whsec_…]
# "TVA 21 %" tax rate, inclusive, created in the Stripe dashboard.
STRIPE_TAX_RATE_ID=[À COMPLÉTER : txr_…]

# ─── Advanced (defaults are fine) ────────────────────────────
# URL shown in the robot's User-Agent (a page explaining the robot to site owners).
# BOT_INFO_URL=https://votre-domaine.be/robot
# Image version to run (default: latest). Set a commit SHA to roll back.
# VERSION=latest
